<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Projet de l'API : le BACK END de BankDesk.
    - Microsoft.NET.Sdk.Web : kit ASP.NET Core (serveur web).
    - Un seul paquet externe : Entity Framework Core + SQLite (la base de données, un simple fichier).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BankDesk.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>

</Project>
